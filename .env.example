# Copy this to .env and fill in your key. .env is gitignored — never commit it.
#
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (macOS/Linux)
#
# Then verify it works:
#
#   python cli.py test-llm

# =====================================================================
# Option A: Ollama Cloud  (uses Ollama's native /api/chat protocol)
# =====================================================================
ATS_LLM_PROVIDER=ollama
ATS_LLM_BASE_URL=ollama-cloud
ATS_LLM_API_KEY=paste-your-ollama-cloud-key-here

# Model must be one your account can reach. Cloud models carry a -cloud or
# :cloud suffix. Check your model list at ollama.com; if you get a 404 or
# "model not found", this line is almost always the cause.
ATS_LLM_MODEL=gpt-oss:120b-cloud

# Other cloud models people commonly have access to:
# ATS_LLM_MODEL=deepseek-v3.1:671b-cloud
# ATS_LLM_MODEL=qwen3-coder:480b-cloud
# ATS_LLM_MODEL=kimi-k2:1t-cloud
# ATS_LLM_MODEL=glm-4.6:cloud
# ATS_LLM_MODEL=minimax-m2:cloud


# =====================================================================
# Option B: local Ollama (no key needed) — comment out Option A first
# =====================================================================
# ATS_LLM_PROVIDER=ollama
# ATS_LLM_BASE_URL=ollama-local
# ATS_LLM_MODEL=llama3.1


# =====================================================================
# Option C: an OpenAI-compatible API (GLM/Zhipu, OpenAI, Groq, DeepSeek)
# =====================================================================
# ATS_LLM_PROVIDER=openai
# ATS_LLM_BASE_URL=glm       # preset; or openai / groq / deepseek / openrouter
# ATS_LLM_MODEL=glm-4-flash
# ATS_LLM_API_KEY=your-key-here
#
# Base-URL presets:
#   ollama-cloud -> https://ollama.com                    (native protocol)
#   ollama-local -> http://localhost:11434                (native protocol)
#   glm          -> https://api.z.ai/api/paas/v4
#   glm-cn       -> https://open.bigmodel.cn/api/paas/v4
#   openai       -> https://api.openai.com/v1
#   groq         -> https://api.groq.com/openai/v1
#   deepseek     -> https://api.deepseek.com/v1
#   openrouter   -> https://openrouter.ai/api/v1
# Or paste any full base URL.
